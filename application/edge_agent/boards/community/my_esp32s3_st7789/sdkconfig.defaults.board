CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y

# N16R8: 16MB flash + 8MB Octal PSRAM
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions_16MB.csv"
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y

# 8 MiB PSRAM next to only 512 KiB internal RAM: without this, malloc() can
# never touch PSRAM and Wi-Fi + LVGL + HTTPD leave ~5 KiB internal free, which
# made newlib's fopen() abort while the skill registry was being scanned.
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=4096
# Keep a smaller pool held back for DMA-only allocations: 32KB starved the
# general internal heap once skills/apps/capabilities were loaded.
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=16384
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y

# AP-only provisioning portal: the Wi-Fi defaults (10 static RX + 32 dynamic RX
# + 32 dynamic TX buffers) are sized for STA throughput and do not fit here.
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=6
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=16
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=16
# wifi_init.c hard-errors unless RX_BA_WIN <= 2 * STATIC_RX_BUFFER_NUM.
CONFIG_ESP_WIFI_RX_BA_WIN=6

# Audio over plain I2S (INMP441 + MAX98357A) and LCD over SPI
CONFIG_CODEC_DUMMY_SUPPORT=y
CONFIG_ESP_BOARD_PERIPH_I2S_SUPPORT=y

# USB Serial/JTAG console
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y

# FATFS long file names: the system/storage image bundles skill and lua
# resources whose names exceed 8.3, and fatfsgen aborts without LFN support.
CONFIG_FATFS_LFN_HEAP=y
CONFIG_FATFS_MAX_LFN=255

# esp_http_server WebSocket support: the webim routes in http_server use
# httpd_ws_* APIs and fail to compile without it.
CONFIG_HTTPD_WS_SUPPORT=y

# http_server_core.c hardcodes config.max_open_sockets = 12, and esp_http_server
# requires LWIP_MAX_SOCKETS >= max_open_sockets + 3 (it keeps 3 sockets itself).
# With the IDF default of 10 the httpd rejects the config, http_server_start()
# returns an error and the app aborts -> the board rebooted every ~1.4 s, which
# looked like the LCD flashing once a second.
# esp_http_server needs LWIP_MAX_SOCKETS >= max_open_sockets(6) + 3 = 9;
# 12 leaves a little head-room without paying for 16 socket buffers in internal RAM.
CONFIG_LWIP_MAX_SOCKETS=12

# Chinese UI text needs the runtime-loaded TTF from the system partition;
# system_ui logs "ui font disabled" and falls back to the tiny built-in font
# without this.
CONFIG_LV_USE_TINY_TTF=y
# LVGL's builtin 64KB pool is a static array in internal DRAM; on this board
# it starves every later malloc. Route LVGL allocations through libc malloc,
# which falls back to the 8MB PSRAM.
CONFIG_LV_USE_CLIB_MALLOC=y

# app_main does the whole bring-up inline: FATFS mount + recovery copy, JSON
# config loads, Wi-Fi/PHY init, LVGL adapter and UI start. The IDF default
# 3.5 KiB main task stack overflows there ("A stack overflow in task main has
# been detected"); 16 KiB still overflows once the SPI display path runs, so
# give main a full 32 KiB (still small enough for internal RAM at boot).
CONFIG_ESP_MAIN_TASK_STACK_SIZE=32768
