CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y

# N16R8: 16MB flash + 8MB Octal PSRAM
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions_16MB.csv"
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y

# Audio over plain I2S (INMP441 + MAX98357A) and LCD over SPI
CONFIG_CODEC_DUMMY_SUPPORT=y
CONFIG_ESP_BOARD_PERIPH_I2S_SUPPORT=y

# USB Serial/JTAG console
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y

# FATFS long file names: the system/storage image bundles skill and lua
# resources whose names exceed 8.3, and fatfsgen aborts without LFN support.
CONFIG_FATFS_LFN_HEAP=y
CONFIG_FATFS_MAX_LFN=255

# esp_http_server WebSocket support: the webim routes in http_server use
# httpd_ws_* APIs and fail to compile without it.
CONFIG_HTTPD_WS_SUPPORT=y

# http_server_core.c hardcodes config.max_open_sockets = 12, and esp_http_server
# requires LWIP_MAX_SOCKETS >= max_open_sockets + 3 (it keeps 3 sockets itself).
# With the IDF default of 10 the httpd rejects the config, http_server_start()
# returns an error and the app aborts -> the board rebooted every ~1.4 s, which
# looked like the LCD flashing once a second.
# esp_http_server needs LWIP_MAX_SOCKETS >= max_open_sockets(12) + 3 = 15
CONFIG_LWIP_MAX_SOCKETS=16

# Chinese UI text needs the runtime-loaded TTF from the system partition;
# system_ui logs "ui font disabled" and falls back to the tiny built-in font
# without this.
CONFIG_LV_USE_TINY_TTF=y
